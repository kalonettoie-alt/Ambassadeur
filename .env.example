# Copiez ce fichier en ".env.local" et remplissez avec les valeurs de
# Supabase > Project Settings > API (ou "API Keys").
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé "anon" (ancienne) ou "publishable" (nouvelle, commence par sb_publishable_) : les deux marchent.
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxx
